{
  "name": "NodeGet Minecraft Theme",
  "short": "NodeGetMinecraft",
  "description": "A Minecraft inspired NodeGet status theme with chunk panels, overworld palette and blocky monitoring UI.",
  "author": "OpenAI x NodeSeekDev",
  "repository": "https://github.com/3257085208/NodeGet-Theme-MC",
  "dist_page": "https://cdn.jsdelivr.net/gh/3257085208/NodeGet-Theme-MC@main/docs",
  "user_preferences_form": {
    "version": "0.0.1",
    "items": [
      {
        "key": "site_name",
        "name": "站点标题",
        "type": "string",
        "default": "NodeGet Overworld Status",
        "help": "输入站点标题"
      },
      {
        "key": "site_logo",
        "name": "站点图标",
        "type": "string",
        "default": "",
        "help": "输入站点图标链接，留空则使用默认"
      },
      {
        "key": "footer",
        "name": "页脚文本",
        "type": "string",
        "default": "Powered by NodeGet in the Overworld",
        "help": "输入页脚文本"
      }
    ]
  },
  "version": "1.4.3",
  "license": ""
}
